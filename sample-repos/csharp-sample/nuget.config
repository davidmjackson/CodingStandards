<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <!--
    The sample consumes the C# profile as a real NuGet package from a local
    feed that prove-gate.sh builds from /profiles/csharp/nuget. This proves the
    "reference alone" claim end to end. The path is relative to this file.
  -->
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
    <add key="local-standards" value="../.localfeed" />
  </packageSources>
</configuration>
